{
    "name": "madtechservices/laravelteams",
    "description": "Laravel package to manage team functionality and operate with user permissions.",
    "keywords": ["laravel", "teams", "groups", "permissions", "abilities", "auth"],
    "license": "MIT",
    "authors": [
        {
            "name": "MAD Tech Services",
            "email": "contact@madtechservices.com.au"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/bus": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/mail": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/queue": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Madtechservices\\LaravelTeams\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "stubs/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Madtechservices\\LaravelTeams\\TeamsServiceProvider"
            ],
            "aliases": {
                "Teams": "Madtechservices\\LaravelTeams\\Support\\Facades\\Teams"
            }
        }
    }
}
